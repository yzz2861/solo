{
  "name": "canteen-ticket-cabinet",
  "version": "1.0.0",
  "description": "社区食堂饭票柜 - 老人饭票管理系统",
  "main": "electron/main.js",
  "scripts": {
    "start": "concurrently \"npm run build\" \"wait-on dist/index.html && electron .\"",
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\""
  },
  "dependencies": {
    "antd": "^5.20.0",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "sql.js": "^1.10.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  }
}
